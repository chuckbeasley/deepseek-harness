<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dsh.Acp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cordis\Cordis.Core\Cordis.Core.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Acp\Dsh.Acp.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Sdk.Protocol\Dsh.Sdk.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Sdk.Client\Dsh.Sdk.Client.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Agent\Dsh.Agent.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.AgentLoop\Dsh.AgentLoop.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Interaction\Dsh.Interaction.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Llm\Dsh.Llm.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Session\Dsh.Session.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Session.Persistence\Dsh.Session.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Spike\Dsh.Spike.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Todo\Dsh.Todo.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Tools\Dsh.Tools.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.SystemPrompt\Dsh.SystemPrompt.csproj" />
    <!-- The profile e2e spawns the real dsh CLI; the reference builds it (without linking) and the
         metadata attribute carries its output path into the test assembly. -->
    <ProjectReference Include="..\..\src\Dsh\Dsh.Cli\Dsh.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <DshCliTargetPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\Dsh\Dsh.Cli\bin\$(Configuration)\$(TargetFramework)\Dsh.Cli.dll'))</DshCliTargetPath>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DshCliPath</_Parameter1>
      <_Parameter2>$(DshCliTargetPath)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
