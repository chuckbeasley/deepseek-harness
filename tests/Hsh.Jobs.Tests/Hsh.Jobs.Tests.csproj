<Project Sdk="Microsoft.NET.Sdk">

  <!-- Zero-dependency console assertion suite (the sandbox blocks dotnet test, so tests run as a
       plain console app via build-and-test-jobs-flow.ps1; this csproj stays the source of truth
       for the integration agent on unrestricted hosts). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Harness.Jobs.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cordis\Cordis.Core\Cordis.Core.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Agent\Hsh.Agent.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Llm\Hsh.Llm.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Session\Hsh.Session.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Tools\Hsh.Tools.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Jobs\Hsh.Jobs.csproj" />
  </ItemGroup>

</Project>
