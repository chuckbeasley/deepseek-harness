<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Harness.Lsp.Tests</RootNamespace>
    <!-- Test methods mirror the TS spec names (underscore-separated); CA1707 is naming noise here. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The fixture is its own project; its sources must not compile into the test runner. -->
    <Compile Remove="Fixtures\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hsh\Hsh.Lsp\Hsh.Lsp.csproj" />
    <!-- The fixture console app lands in the test output so the suites can spawn it via dotnet exec. -->
    <ProjectReference Include="Fixtures\FakeLspServer\FakeLspServer.csproj" />
  </ItemGroup>

</Project>
