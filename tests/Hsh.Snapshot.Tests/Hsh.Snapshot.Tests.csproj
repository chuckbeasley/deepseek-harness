<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Harness.Snapshot.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cordis\Cordis.Core\Cordis.Core.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Llm\Hsh.Llm.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Llm.Replay\Hsh.Llm.Replay.csproj" />
    <!-- The profile e2e spawns the real hsh CLI; the reference builds it (without linking) and the
         metadata attribute carries its output path into the test assembly. -->
    <ProjectReference Include="..\..\src\Hsh\Hsh.Cli\Hsh.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <HshCliTargetPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\Hsh\Hsh.Cli\bin\$(Configuration)\$(TargetFramework)\Hsh.Cli.dll'))</HshCliTargetPath>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HshCliPath</_Parameter1>
      <_Parameter2>$(HshCliTargetPath)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$(RepoRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="patches\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>