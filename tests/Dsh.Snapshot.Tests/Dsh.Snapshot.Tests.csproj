<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dsh.Snapshot.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cordis\Cordis.Core\Cordis.Core.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Llm\Dsh.Llm.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Llm.Replay\Dsh.Llm.Replay.csproj" />
    <!-- The profile e2e spawns the real dsh CLI; the reference builds it (without linking) and the
         metadata attribute carries its output path into the test assembly. -->
    <ProjectReference Include="..\..\src\Dsh\Dsh.Cli\Dsh.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <DshCliTargetPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\Dsh\Dsh.Cli\bin\$(Configuration)\$(TargetFramework)\Dsh.Cli.dll'))</DshCliTargetPath>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DshCliPath</_Parameter1>
      <_Parameter2>$(DshCliTargetPath)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$(RepoRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="patches\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>