<Project Sdk="Microsoft.NET.Sdk">

  <!-- Zero-dependency console assertion suite (runs as a plain console app; the csproj stays the
       source of truth for unrestricted hosts). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dsh.Webhook.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cordis\Cordis.Core\Cordis.Core.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Credentials\Dsh.Credentials.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Webhook\Dsh.Webhook.csproj" />
  </ItemGroup>

</Project>
