<Project Sdk="Microsoft.NET.Sdk">

  <!-- Zero-dependency console assertion suite (the sandbox blocks dotnet test, so tests run as a
       plain console app via build-and-test.ps1; this csproj stays the source of truth for the
       integration agent on unrestricted hosts). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dsh.Spike.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dsh\Dsh.Session\Dsh.Session.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Llm\Dsh.Llm.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Tools\Dsh.Tools.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Spike\Dsh.Spike.csproj" />
  </ItemGroup>

</Project>
