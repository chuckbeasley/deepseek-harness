<Project Sdk="Microsoft.NET.Sdk">

  <!-- Zero-dependency console assertion suite (the sandbox blocks dotnet test, so tests run as a
       plain console app via build-and-test-system-prompt.ps1; this csproj stays the source of truth
       for the integration agent on unrestricted hosts). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dsh.SystemPrompt.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cordis\Cordis.Core\Cordis.Core.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Llm\Dsh.Llm.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.Tools\Dsh.Tools.csproj" />
    <ProjectReference Include="..\..\src\Dsh\Dsh.SystemPrompt\Dsh.SystemPrompt.csproj" />
  </ItemGroup>

</Project>
