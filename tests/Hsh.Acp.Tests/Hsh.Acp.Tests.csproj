<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Harness.Acp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cordis\Cordis.Core\Cordis.Core.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Acp\Hsh.Acp.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Sdk.Protocol\Hsh.Sdk.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Sdk.Client\Hsh.Sdk.Client.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Agent\Hsh.Agent.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.AgentLoop\Hsh.AgentLoop.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Interaction\Hsh.Interaction.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Llm\Hsh.Llm.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Session\Hsh.Session.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Session.Persistence\Hsh.Session.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Spike\Hsh.Spike.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Todo\Hsh.Todo.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.Tools\Hsh.Tools.csproj" />
    <ProjectReference Include="..\..\src\Hsh\Hsh.SystemPrompt\Hsh.SystemPrompt.csproj" />
    <!-- The profile e2e spawns the real hsh CLI; the reference builds it (without linking) and the
         metadata attribute carries its output path into the test assembly. -->
    <ProjectReference Include="..\..\src\Hsh\Hsh.Cli\Hsh.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <HshCliTargetPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\Hsh\Hsh.Cli\bin\$(Configuration)\$(TargetFramework)\Hsh.Cli.dll'))</HshCliTargetPath>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HshCliPath</_Parameter1>
      <_Parameter2>$(HshCliTargetPath)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
