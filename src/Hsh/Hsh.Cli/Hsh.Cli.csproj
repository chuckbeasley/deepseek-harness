<?xml version="1.0" encoding="utf-8"?>
<!-- The CLI is the executable that boots the web host (hsh web), so it must be a Web SDK project:
     the Blazor framework assets (_framework/blazor.web.js) only flow into an SDK.Web executable's
     static web assets manifest. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Harness.Cli</RootNamespace>
    <!-- The bundle manifests are declared explicitly below; the Web SDK's default Content glob
         (wwwroot and friends) would duplicate them. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <!-- The CLI hosts the Razor components app (hsh web) but carries no .razor files of its own,
         so the SDK's automatic condition would skip the Blazor framework assets; the host needs
         them regardless. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <!-- Phase 8 packaging: the runtime ships as the DeepSeek.Harness dotnet tool (command hsh);
         the SDK client spawns it and the corpus replays through it. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hsh</ToolCommandName>
    <PackageId>Harness</PackageId>
    <Description>The Harness runtime (hsh): the agent harness CLI, headless profile, TUI, and web host. Install as a dotnet tool; the Harness.Sdk client drives it.</Description>
  </PropertyGroup>

