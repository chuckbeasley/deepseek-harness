@inject Harness.Cordis.Core.Context Ctx
@inject WebLocale Locale
@implements IDisposable

<section class="hsh-workspace-list">
    <h3>@Locale.T("workspaces")</h3>
    @if (List().Count == 0)
    {
        <p class="hsh-muted">@Locale.T("noWorkspaces")</p>
    }
    @foreach (var workspace in List())
    {
        <div class="hsh-workspace-item">
            <span class="hsh-workspace-title">@workspace.Title</span>
        </div>
    }
</section>

@code {
    private readonly List<IDisposable> _subscriptions = new();
    private Harness.Workspace.WorkspaceRegistry? _registry;

    protected override void OnInitialized()
    {
        _registry = Ctx.Get<Harness.Workspace.WorkspaceRegistry>("workspaceRegistry");
        if (_registry is null) return;
        foreach (var eventName in new[] { Harness.Workspace.WorkspaceRegistryEvents.Upserted, Harness.Workspace.WorkspaceRegistryEvents.Removed, Harness.Workspace.WorkspaceRegistryEvents.Order, Harness.Workspace.WorkspaceRegistryEvents.Archived })
        {
            _subscriptions.Add(Ctx.On(eventName, new Action<object>(_ => StateHasChanged())));
        }
    }

    public void Dispose()
    {
        foreach (var subscription in _subscriptions) subscription.Dispose();
        _subscriptions.Clear();
    }

    private IReadOnlyList<Harness.Workspace.Workspace> List()
        => _registry is null ? Array.Empty<Harness.Workspace.Workspace>() : _registry.List();
}
