<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Harness.Session.Titles</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hsh.Session pulls Cordis.Core (Service/Context) and Hsh.Llm transitively for dotnet build;
         the direct-csc build script adds the explicit -r edges. -->
    <ProjectReference Include="..\Hsh.Session\Hsh.Session.csproj" />
    <!-- The fallback flush trigger: the agent/request waterfall fires after the pre-step batch
         commits and before the request header, the recorded session/title position. -->
    <ProjectReference Include="..\Hsh.AgentLoop\Hsh.AgentLoop.csproj" />
  </ItemGroup>

</Project>