@page "/"
@rendermode InteractiveServer
@inject Harness.Cordis.Core.Context Ctx
@inject Harness.Web.App.Store.WebSessionStore Store
@inject SlotRegistry Slots
@inject WebLocale Locale
@inject LocaleScope LocaleScope
@inject ShellState State
@inject ShellBus Bus
@inject IHttpContextAccessor Http
@inject PersistentComponentState ComponentState
@implements IDisposable

<div class="hsh-chat">
    <section class="hsh-sessions">
        <SlotOutlet Slot="sessions" />
    </section>

    <section class="hsh-transcript">
        @if (State.Selected is null)
        {
            <p class="hsh-muted">@Locale.T("selectSession")</p>
        }
        else
        {
            @if (State.Selected.Error is { } error)
            {
                <div class="hsh-error">@Locale.T("lastError") @error</div>
            }
            <div class="hsh-messages">
                @foreach (var evt in State.Selected.Events)
                {
                    @RenderEvent(evt)
                }
            </div>
        }
        <SlotOutlet Slot="chat.composer" />
    </section>
    <SlotOutlet Slot="shell.overlay" />
</div>

@code {
    private bool _busy;
    private IDisposable? _storeSubscription;
    private Action<string>? _sendHandler;

    protected override void OnInitialized()
    {
        _storeSubscription = Store.Subscribe(StateHasChanged);
        if (State.Selected is null)
        {
            State.Select(Store.List().FirstOrDefault());
        }
        State.Changed += StateHasChanged;
        Bus.NewSessionRequested += NewSession;
        _sendHandler = text => _ = SendAsync(text);
        Bus.SendRequested += _sendHandler;
        ResolveLocale();
    }

    /// <summary>
    /// Pin the shell's language for this scope: the prerender takes it from the request's
    /// Accept-Language (via the locale middleware) and persists it; the interactive circuit takes
    /// the persisted value back, so both renders agree.
    /// </summary>
    private void ResolveLocale()
    {
        if (ComponentState.TryTakeFromJson(WebLocale.StateKey, out string? language) && language is not null)
        {
            LocaleScope.Language = language;
            return;
        }
        if (Http.HttpContext is { } http
            && http.Items.TryGetValue(WebLocale.ItemsKey, out var value)
            && value is string negotiated)
        {
            LocaleScope.Language = negotiated;
            ComponentState.RegisterOnPersisting(() =>
            {
                ComponentState.PersistAsJson(WebLocale.StateKey, negotiated);
                return Task.CompletedTask;
            });
        }
    }

    public void Dispose()
    {
        _storeSubscription?.Dispose();
        State.Changed -= StateHasChanged;
        Bus.NewSessionRequested -= NewSession;
        if (_sendHandler is not null) Bus.SendRequested -= _sendHandler;
    }

    /// <summary>The sidebar's New Session action: clear the selection so the next send starts fresh.</summary>
    private void NewSession() => State.Select(null);

    private async Task SendAsync(string text)
    {
        if (text.Length == 0 || _busy) return;
        _busy = true;
        try
        {
            var sessionId = State.Selected?.Session.Id ?? new Harness.Session.SessionId($"session-{Guid.NewGuid():N}");
            var loop = Ctx.Get<Harness.AgentLoop.AgentLoop>("agentLoop")
                ?? throw new InvalidOperationException("the web chat requires the agentLoop row");
            if (State.Selected is null)
            {
                var key = Environment.GetEnvironmentVariable("DEEPSEEK_API_KEY");
                var provider = string.IsNullOrEmpty(key) ? "mock" : "deepseek";
                var model = string.IsNullOrEmpty(key) ? "mock-todo" : "deepseek-chat";
                var handle = loop.Create(sessionId, new Harness.Agent.AgentOptions { Provider = provider, Model = model });
                var driver = loop.GetLoop(sessionId)
                    ?? throw new InvalidOperationException("the loop published no driver");
                State.Select(Store.Get(sessionId));
                await RunTurnAsync(driver, text);
            }
            else
            {
                var driver = loop.GetLoop(sessionId)
                    ?? throw new InvalidOperationException("the session has no live loop");
                await RunTurnAsync(driver, text);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static async Task RunTurnAsync(Harness.AgentLoop.LoopAgent driver, string text)
    {
        var message = new Harness.Llm.UserMessage
        {
            Id = new Harness.Llm.MessageId(Guid.NewGuid().ToString("N")),
            Content = new Harness.Llm.ContentBlock[] { new Harness.Llm.TextBlock(text) },
            Source = new Harness.Llm.UserSource(),
        };
        driver.Send(message, Harness.Agent.InboxTarget.NextTurn, wakeup: true);
        await driver.WhenIdleAsync();
    }

    private static RenderFragment RenderEvent(Harness.Session.SessionEvent evt) => __builder =>
    {
        switch (evt)
        {
            case Harness.Session.UserMessageEvent user:
                <div class="hsh-bubble hsh-user">@(string.Concat(user.Message.Content.OfType<Harness.Llm.TextBlock>().Select(block => block.Text)))</div>
                break;
            case Harness.Session.AssistantMessageEvent assistant:
                <div class="hsh-bubble hsh-assistant">@(string.Concat(assistant.Message.Content.OfType<Harness.Llm.TextBlock>().Select(block => block.Text)))</div>
                break;
            case Harness.Session.AssistantChunkEvent chunk when chunk.Chunk is Harness.Llm.TextDelta delta:
                <div class="hsh-bubble hsh-assistant">@delta.Text</div>
                break;
            case Harness.Session.ToolCallEvent tool:
                <div class="hsh-bubble hsh-tool">tool @tool.Name</div>
                break;
        }
    };
}
