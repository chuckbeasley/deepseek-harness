@inject Cordis.Core.Context Ctx
@inject WebLocale Locale
@implements IDisposable

<section class="dsh-workspace-list">
    <h3>@Locale.T("workspaces")</h3>
    @if (List().Count == 0)
    {
        <p class="dsh-muted">@Locale.T("noWorkspaces")</p>
    }
    @foreach (var workspace in List())
    {
        <div class="dsh-workspace-item">
            <span class="dsh-workspace-title">@workspace.Title</span>
        </div>
    }
</section>

@code {
    private readonly List<IDisposable> _subscriptions = new();
    private Dsh.Workspace.WorkspaceRegistry? _registry;

    protected override void OnInitialized()
    {
        _registry = Ctx.Get<Dsh.Workspace.WorkspaceRegistry>("workspaceRegistry");
        if (_registry is null) return;
        foreach (var eventName in new[] { Dsh.Workspace.WorkspaceRegistryEvents.Upserted, Dsh.Workspace.WorkspaceRegistryEvents.Removed, Dsh.Workspace.WorkspaceRegistryEvents.Order, Dsh.Workspace.WorkspaceRegistryEvents.Archived })
        {
            _subscriptions.Add(Ctx.On(eventName, new Action<object>(_ => StateHasChanged())));
        }
    }

    public void Dispose()
    {
        foreach (var subscription in _subscriptions) subscription.Dispose();
        _subscriptions.Clear();
    }

    private IReadOnlyList<Dsh.Workspace.Workspace> List()
        => _registry is null ? Array.Empty<Dsh.Workspace.Workspace>() : _registry.List();
}
