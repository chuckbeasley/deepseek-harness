<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Harness.Sdk.Client</RootNamespace>
    <!-- The public SDK surface (the .NET replacement for the retired Python SDK):
         the package consumers restore. -->
    <PackageId>Harness.Sdk</PackageId>
    <Description>The Harness .NET client SDK: spawns the dsh runtime as a subprocess and drives typed session turns over the JSON-RPC line transport.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dsh.Sdk.Protocol\Dsh.Sdk.Protocol.csproj" />
    <ProjectReference Include="..\Dsh.Llm\Dsh.Llm.csproj" />
    <InternalsVisibleTo Include="Dsh.Sdk.Client.Tests" />
  </ItemGroup>

</Project>
